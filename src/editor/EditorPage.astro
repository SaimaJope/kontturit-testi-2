---
import CloudEditor from './CloudEditor';
import { getCollection } from 'astro:content';
export function getStaticPaths() {
  return [{params:{params:undefined}},{params:{params:'cloud/oauth/callback'}}];
}
const editorBase = import.meta.env.BASE_URL.replace(/\/$/,'')+'/keystatic';
const articles = (await getCollection('news')).sort((a,b) => new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime()).slice(0,3).map(item => ({id: item.id, title: item.data.title, date: new Date(item.data.date || 0).toLocaleDateString('fi-FI'), image: item.data.image}));
---
<!doctype html>
<html lang="fi" data-cloud-editor>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content="Kontturin testisivuston sisällönhallinta. Kirjaudu muokkaamaan uutisia ja sivuston sisältöä." />
    <title>Sisällönhallinta | Kontturi & Co</title>
  </head>
  <body data-editor-base={editorBase}>
    <script is:inline>
      const requestedPath = new URLSearchParams(location.search).get('editorPath');
      if (requestedPath) {
        const destination = new URL(requestedPath, location.origin);
        if (destination.origin === location.origin && destination.pathname.startsWith(document.body.dataset.editorBase + '/')) {
          history.replaceState(null, '', destination.pathname + destination.search + destination.hash);
        }
      }
      // GitHub Pages redirects directory URLs to a trailing slash, while
      // Keystatic matches the OAuth callback and item routes exactly.
      if (location.pathname.startsWith(document.body.dataset.editorBase + '/') && location.pathname.endsWith('/')) {
        history.replaceState(null, '', location.pathname.replace(/\/+$/, '') + location.search + location.hash);
      }
    </script>
    <CloudEditor articles={articles} client:only="react" />
    <noscript>Sisällönhallinta tarvitsee JavaScriptin. Ota JavaScript käyttöön selaimen asetuksista.</noscript>
  </body>
</html>
