---
import '@fontsource/montserrat/latin-ext-400.css';
import '@fontsource/montserrat/latin-ext-500.css';
import '@fontsource/montserrat/latin-400.css';
import '@fontsource/montserrat/latin-500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteMotion from '../components/SiteMotion.astro';
import {offices} from '../lib/site';
import brand from '../data/brand.json';
interface Props { noIndex?: boolean; title: string; description?: string; schema?: Record<string,unknown>|Record<string,unknown>[]; }
const {title,description='Asianajotoimisto Kontturi & Co. Oikeudellista apua ihmiseltä ihmiselle Joensuussa, Jyväskylässä ja Lappeenrannassa.',schema,noIndex=false}=Astro.props;
const origin=Astro.site?.href||'https://kontturi.fi';
const locations=await offices();
const organization={'@context':'https://schema.org','@type':'LegalService','@id':new URL('#organization',origin).href,name:'Asianajotoimisto Kontturi & Co Oy',url:origin,logo:new URL(brand.logo,origin).href,telephone:locations[0].data.phone,areaServed:locations.map(({data:o})=>({'@type':'City',name:o.title})),department:locations.map(({data:o})=>({'@type':'LegalService',name:`Kontturi & Co – ${o.title}`,url:new URL(o.route,origin).href,telephone:o.phone,email:o.email,address:{'@type':'PostalAddress',streetAddress:o.address,postalCode:o.postalCode,addressLocality:o.title,addressCountry:'FI'}}))};
const schemas=[organization,...(Array.isArray(schema)?schema:schema?[schema]:[])];
const canonical=new URL(Astro.url.pathname,origin).href;
const isIndexable=import.meta.env.PUBLIC_INDEXABLE==='true' && !noIndex;
---
<!doctype html><html lang="fi"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#0569B5"/><title>{title} | Kontturi & Co</title><meta name="description" content={description}/><meta name="robots" content={isIndexable?'index,follow':'noindex,nofollow'}/><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><meta property="og:title" content={`${title} | Kontturi & Co`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:locale" content="fi_FI"/><meta property="og:url" content={canonical}/>{<script is:inline type="application/ld+json" set:html={JSON.stringify(schemas).replace(/</g,'\\u003c')}/>}</head><body><SiteMotion/><a class="skip-link" href="#sisalto">Siirry sisältöön</a><Header/><main id="sisalto" tabindex="-1"><slot/></main><Footer/></body></html>
