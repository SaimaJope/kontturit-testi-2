---
import { offices, phoneHref } from '../lib/site';
import Icon from './Icon.astro';
const locations=await offices();
---
<footer class="site-footer">
 <div class="container">
  <div class="footer-top"><a class="footer-name" href="/">Asianajotoimisto Kontturi & Co Oy</a><a class="back-top" href="#alku">Takaisin alkuun <Icon name="up"/></a></div>
  <div class="footer-grid">{locations.map(({data:o})=><div><h2><a href={o.route}>{o.title}</a></h2><p>{o.address}<br/>{o.postalCode} {o.title}</p><p><a href={phoneHref(o.phone)}>{o.phone}</a></p><p>{o.hours}</p></div>)}
   <div class="footer-contact"><h2>Ollaan yhteydessä</h2><a href="mailto:asianajotoimisto@kontturi.fi">asianajotoimisto@kontturi.fi</a><div class="socials"><a href="https://www.facebook.com/asianajotoimisto.kontturi" aria-label="Facebook" class="social-letter">f</a><a href="https://www.instagram.com/asianajotoimisto_kontturi" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a><a href="https://www.linkedin.com/company/attorneys-at-law-kontturi-&-co-ltd-" aria-label="LinkedIn" class="social-letter linkedin">in</a></div><div class="footer-duty"><p>Päivystys iltaisin ja viikonloppuisin</p><a href="tel:+358400208030">+358 400 20 80 30</a></div></div>
  </div>
  <nav class="footer-links" aria-label="Lisätietoja"><a href="/meista">Meistä</a><a href="/trainee-ohjelma">Trainee-ohjelma</a><a href="/yhteistyossa">Yhteistyössä</a><a href="/yhteistyossa/osuuskaupan-asiakasomistaja">Asiakasomistajaedut</a><a href="/yhteistyossa/yritysjuristi">Yritysjuristi</a><a href="/tietosuojaseloste">Tietosuojaseloste</a>{import.meta.env.PUBLIC_KEYSTATIC_CLOUD_PROJECT && <a href="/keystatic/">Muokkaa sivustoa</a>}</nav>
  <div class="footer-bottom"><span class="wordmark">KONTTURI & CO</span><span>Joensuu · Jyväskylä · Lappeenranta</span></div>
 </div>
</footer>
